# Google Analytics (client-side tracking tag)
NEXT_PUBLIC_GOOGLE_ANALYTICS=your-ga-measurement-id

# Admin login code
NEXT_PUBLIC_ADMIN_CODE=your-secret-code
ADMIN_CODE=your-secret-code

# GA4 Data API — required for the admin dashboard to show real analytics
# 1. Create a service account in Google Cloud Console
# 2. Enable the Google Analytics Data API
# 3. Add the service account email as Viewer on your GA4 property
# 4. Get your GA4 Property ID from Admin > Property Settings
GA4_PROPERTY_ID=your-ga4-property-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"
